# ─── Application ──────────────────────────────────────────────
APP_NAME="Kalban"
APP_DESCRIPTION="Boards, lists and cards for your projects, your home and your free time, with your calendars built in: on your own or with anyone you like."
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=Europe/Rome
# Default language and available languages (comma separated, must exist in /lang)
APP_LOCALE=it
APP_LOCALES=it,en
# Encrypts the calendar passwords stored in the database. Create it with: php bin/key.php
APP_KEY=

# ─── Database (MySQL) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kalban
DB_USERNAME=kalban
DB_PASSWORD=secret

# ─── Session ──────────────────────────────────────────────────
SESSION_NAME=kalban_session

# ─── Features ────────────────────────────────────────────────
# Set to false to close public sign-ups (initial value, can be changed from the back-office).
# People invited to a board can always sign up with the invited address.
REGISTRATION_ENABLED=true
# New users must confirm their email address before signing in (needs a working MAIL_* setup)
EMAIL_VERIFICATION=false
# Max size of a card attachment, in MB (keep upload_max_filesize in public/.user.ini above it)
ATTACHMENT_MAX_MB=10
# Most cards and lists a board can hold (archived ones don't count); past them a message says so
BOARD_MAX_CARDS=400
BOARD_MAX_LISTS=50

# Board backgrounds from Unsplash: create a free app at https://unsplash.com/developers and paste
# its Access Key here. Without it only the colour palette is offered.
UNSPLASH_ACCESS_KEY=

# Calendar (CalDAV, e.g. iCloud): minimum seconds between two syncs of the same account.
# iCloud slows down apps that ask too often; when it answers "retry later" the app waits as told.
CALENDAR_SYNC_SECONDS=60
# Minutes between start and end set when the start of an event changes (each user can change it in Settings)
EVENT_DEFAULT_MINUTES=30
# Days from today the calendar opens at on wider screens (-1: yesterday is visible too; phones always open on today)
CALENDAR_START_OFFSET_DAYS=-1
# New events from quick add: whole-day ones (true), or timed ones, opened in a window to check before saving (false).
# Each calendar can change it in Settings; this is the starting value of a newly connected one.
CALENDAR_NEW_ALL_DAY=false

# Private data (attachments, avatars, cache, logs). Default: storage/ inside the project.
# Absolute path, or relative to the project folder. It must NOT be reachable from the web:
# e.g. STORAGE_PATH=../kalban-data  →  a folder next to the project, outside htdocs.
# STORAGE_PATH=storage

# ─── Email ────────────────────────────────────────────────────
# Used for board invitations to people without an account, and for email confirmation.
# MAIL_DRIVER: mail (PHP mail(), fine on most shared hosting), smtp, or log (writes to storage/logs/mail.log)
MAIL_DRIVER=mail
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Kalban"
# Only for MAIL_DRIVER=smtp. MAIL_ENCRYPTION: tls (STARTTLS, usually port 587), ssl (465) or none
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── API (/api/v1, documentation at /api/docs) ────────────────
# false: no API for anybody (the section disappears from Settings)
API_ENABLED=true
# How long a token lasts, in days, from when it is generated
API_TOKEN_DAYS=90
# Requests a minute per token
THROTTLE_API_PER_MINUTE=60

# ─── Rate limits ──────────────────────────────────────────────
# Counted per account (the email typed at sign-in, or the signed-in user); sign-ups with one counter
# for the whole site. No IP address is stored: counters are kept under a hash and forgotten when they expire.
# Wrong passwords at sign-in, per account, then a pause of THROTTLE_LOGIN_MINUTES
THROTTLE_LOGIN_ATTEMPTS=5
THROTTLE_LOGIN_MINUTES=15
# Wrong current password when changing it or deleting the account
THROTTLE_PASSWORD_ATTEMPTS=5
THROTTLE_PASSWORD_MINUTES=15
# Sign-up attempts per hour on the whole site; above it everyone is asked to try again later
THROTTLE_REGISTER_PER_HOUR=30
# New confirmation emails per address, per hour
THROTTLE_RESEND_PER_HOUR=3
# Board invitations a user can send per hour (they may email anyone)
THROTTLE_INVITES_PER_HOUR=30
# Attempts to connect a calendar per user, per hour (each one is a request to iCloud or the CalDAV server)
THROTTLE_CALENDAR_CONNECT_PER_HOUR=10

# ─── Users ────────────────────────────────────────────────────
# Max size of an uploaded profile picture, in KB (it is cropped to 256x256)
AVATAR_MAX_KB=4096

# ─── First administrator (created on the first visit, or by `php bin/migrate.php`) ─
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ─── Legal (shown in the Privacy and Cookie policies) ─────────
LEGAL_CONTROLLER_NAME="Your Company S.r.l."
LEGAL_CONTROLLER_ADDRESS="Street 1, 00100 City, Italy"
LEGAL_CONTACT_EMAIL=privacy@example.com
LEGAL_DATA_LOCATION="the European Union"
LEGAL_LOG_RETENTION_DAYS=30
LEGAL_POLICY_DATE=2026-10-21

# Animated passage between pages (dashboard tile → board): on/off, and how long it lasts
VIEW_TRANSITIONS=true
VIEW_TRANSITION_SECONDS=0.2
